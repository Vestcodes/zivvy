{
  "name": "@zivvy/api",
  "version": "0.1.0",
  "description": "Thin API gateway deployed on Vercel that proxies to a Frappe/ERPNext backend",
  "private": true,
  "scripts": {
    "build": "rm -f tsconfig.build.tsbuildinfo && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "vercel-build": "rm -f tsconfig.build.tsbuildinfo && nest build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@mdx-js/mdx": "^3.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "redoc-express": "^2.1.0",
    "reflect-metadata": "^0.2.2",
    "rehype-stringify": "^10.0.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}

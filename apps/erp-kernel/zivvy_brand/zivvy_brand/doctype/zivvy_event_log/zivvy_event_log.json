{
  "name": "Zivvy Event Log",
  "module": "Zivvy Brand",
  "doctype": "DocType",
  "document_type": "Other",
  "engine": "InnoDB",
  "field_order": [
    "event_type",
    "resource",
    "resource_name",
    "column_break_1",
    "zivvy_tenant",
    "triggered_by",
    "section_break_payload",
    "payload"
  ],
  "fields": [
    {
      "fieldname": "event_type",
      "fieldtype": "Data",
      "label": "Event Type",
      "reqd": 1,
      "in_list_view": 1,
      "description": "e.g. sales-orders.created"
    },
    {
      "fieldname": "resource",
      "fieldtype": "Data",
      "label": "Resource",
      "in_list_view": 1,
      "description": "Resource slug e.g. sales-orders"
    },
    {
      "fieldname": "resource_name",
      "fieldtype": "Data",
      "label": "Resource Name",
      "in_list_view": 1,
      "description": "Document name e.g. SO-00001"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "zivvy_tenant",
      "fieldtype": "Data",
      "label": "Tenant",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "triggered_by",
      "fieldtype": "Link",
      "label": "Triggered By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "section_break_payload",
      "fieldtype": "Section Break",
      "label": "Event Data",
      "collapsible": 1
    },
    {
      "fieldname": "payload",
      "fieldtype": "Code",
      "label": "Payload",
      "options": "JSON",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1
    },
    {
      "role": "Zivvy Tenant Admin",
      "read": 1
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC",
  "autoname": "format:ZEVT-{######}",
  "naming_rule": "Expression (old style)"
}

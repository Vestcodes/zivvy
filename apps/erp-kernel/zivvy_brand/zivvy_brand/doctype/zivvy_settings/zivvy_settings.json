   "fieldname": "analytics_section",
   "fieldtype": "Section Break",
   "label": "PostHog Analytics"
  },
  {
   "default": "0",
   "description": "Load PostHog only after the visitor accepts analytics cookies (choice=all).",
   "fieldname": "enable_posthog",
   "fieldtype": "Check",
   "label": "Enable PostHog"
  },
  {
   "depends_on": "eval:doc.enable_posthog",
   "description": "Project API key from PostHog. Prefer env POSTHOG_PROJECT_API_KEY in production.",

   "fieldname": "posthog_host",
   "fieldtype": "Select",
   "label": "PostHog Host",
   "options": "US\nEU\nCustom"
  },
  {
   "depends_on": "eval:doc.enable_posthog && doc.posthog_host==\"Custom\"",
   "description": "e.g. https://posthog.example.com",

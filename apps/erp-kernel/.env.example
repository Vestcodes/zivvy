# Zivvy production — https://zivvy.xyz
# Copy to your process env / secrets manager. Never commit real values.

# --- Site ---
# Prefer apex; redirect www → https://zivvy.xyz
SITE_URL=https://zivvy.xyz

# --- Polar.sh billing (https://polar.sh/docs) ---
# Organization Access Token from Polar dashboard
POLAR_ACCESS_TOKEN=

# Webhook signing secret from Polar → Settings → Webhooks
# Endpoint: https://zivvy.xyz/api/method/zivvy_brand.billing.webhooks.polar_webhook
POLAR_WEBHOOK_SECRET=

# Optional organization id / slug (reference)
POLAR_ORGANIZATION_ID=
POLAR_ORGANIZATION_SLUG=

# Seat-based product IDs (Pro $18/mo, Business $30/mo; annual = 20% off)
POLAR_PRO_PRODUCT_ID=
POLAR_BUSINESS_PRODUCT_ID=
POLAR_PRO_ANNUAL_PRODUCT_ID=
POLAR_BUSINESS_ANNUAL_PRODUCT_ID=

# Checkout return URLs (production defaults)
POLAR_SUCCESS_URL=https://zivvy.xyz/app/billing
POLAR_CANCEL_URL=https://zivvy.xyz/pricing

# 0 = live api.polar.sh · 1 = sandbox-api.polar.sh
POLAR_USE_SANDBOX=0

# --- PostHog analytics (optional — also Zivvy Settings) ---
# Loads only after visitor accepts analytics cookies
POSTHOG_ENABLE=0
POSTHOG_PROJECT_API_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLE_DESK=0

# --- Resend transactional email (https://resend.com/docs/send-with-smtp) ---
# SMTP: smtp.resend.com:465 (SSL), username `resend`, password = API key
# Verify domain DNS in Resend dashboard before sending from @zivvy.xyz
RESEND_API_KEY=
RESEND_FROM_EMAIL=Zivvy <noreply@zivvy.xyz>

# --- Demo accounts (smoke tests; never commit real values) ---
# Seed: bench --site zivvy.xyz execute zivvy_brand.setup.seed_demo_accounts.seed_demo_accounts
DEMO_FREE_PASSWORD=
DEMO_PRO_PASSWORD=
DEMO_BUSINESS_PASSWORD=
